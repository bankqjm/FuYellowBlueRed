# FuYellowBlueRed - 环境配置模板
# 使用说明：复制此文件为 .env，然后根据实际情况修改配置值
# 敏感配置（如数据库连接信息）请写入 .env.local 文件，该文件会自动覆盖 .env 中的同名配置
#
# 配置加载优先级（从高到低）：
#   1. 系统环境变量
#   2. .env.local 文件（本地开发专用，不纳入版本控制）
#   3. .env 文件（基础配置，不纳入版本控制）
#   4. 代码中的默认值

# 数据库连接配置
# MySQL/OceanBase 格式：mysql+aiomysql://用户名:密码@主机地址:端口/数据库名
# SQLite 本地格式：sqlite+aiosqlite:///./data.db
DATABASE_URL=sqlite+aiosqlite:///./data.db

# 认证配置
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# 跨域配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# 调试模式（生产环境请设为 False）
DEBUG=True

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# 接口限流配置
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=30
LOG_JSON_FORMAT=False
LOG_ERROR_FILE_ENABLED=True

# 存储配置（local 或 s3）
STORAGE_TYPE=local
# S3/MinIO 配置（仅在 STORAGE_TYPE=s3 时生效）
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=fyybr-uploads
S3_REGION=us-east-1
S3_URL_PREFIX=
