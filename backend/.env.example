# FuYellowBlueRed - Environment Configuration

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./data.db

# Authentication Settings
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# Debug Mode (Set to False in Production)
DEBUG=True

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging Settings
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=30
LOG_JSON_FORMAT=False
LOG_ERROR_FILE_ENABLED=True

# Storage Settings (local or s3)
STORAGE_TYPE=local
# S3/MinIO Settings (only used when STORAGE_TYPE=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=fyybr-uploads
S3_REGION=us-east-1
S3_URL_PREFIX=
